root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.json]
indent_size = 2
indent_style = space
ij_json_array_wrapping = off
ij_json_keep_line_breaks = false

[*.md]
indent_size = 2
indent_style = space
tab_width = 2

[*.sh]
indent_size = 4
indent_style = tab
max_line_length = off
tab_width = 4
ij_shell_wrap_long_lines = false